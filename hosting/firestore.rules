rules_version = '2';
// ERTEL Toptan — Firestore güvenlik kuralları
// Bayi: sadece katalog + kendi talepleri + kendi özel fiyatları. Yönetici: her şey.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().role == 'admin'; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active != false; }

    // İlk kurulum: yönetici sahibi bir kez yazılır
    // otomatik eşitlemenin son çalışma bilgisi (sunucu yazar, yönetici okur)
    match /meta/sync { allow read: if isAdmin(); }
    match /meta/feed { allow read: if isAdmin(); }
    match /meta/usage { allow read: if isAdmin(); }
    match /meta/deleted { allow read, write: if isAdmin(); }
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // Giriş ekranındaki logo / dükkan bilgisi herkese açık
    match /settings/public { allow read: if true; allow write: if isAdmin(); }
    match /settings/{doc} { allow read: if isActive(); allow write: if isAdmin(); }
    match /catalog/{doc} { allow read: if isActive(); allow write: if isAdmin(); }
    // alış fiyatları sadece yönetici (bayiler katalogu okuyabildiği için ayrı belgede)
    match /costs/{doc} { allow read, write: if isAdmin(); }
    // ziyaretçi mağazası: toptan fiyatsız katalog herkese açık
    match /pubcatalog/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /img/{doc} { allow read: if true; allow write: if isAdmin(); }
    // mağaza ana sayfası resimleri (banner, marka logosu, kutular)
    match /shopimg/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /desc/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /descb/{doc} { allow read: if true; allow write: if isAdmin(); } // açıklama kovaları (tek ürün)

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 1) bayi kendi başvurusunu yazar (pasif + onay bekliyor), 2) yönetici oluşturur, 3) ilk kurulumda sahip kendi kaydını yazar
      allow create: if (signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'customer'
          && request.resource.data.active == false
          && request.resource.data.pending == true
          && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'shop', 'phone', 'role', 'active', 'pending', 'tier', 'createdAt'])
          && request.resource.data.tier == '')
        || isAdmin()
        || (signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/meta/owner).data.uid == uid);
      // bayi sadece ad / dükkan / telefon / foto değiştirebilir
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'shop', 'phone', 'photo']));
      allow delete: if isAdmin();
    }
    match /userNotes/{uid} { allow read, write: if isAdmin(); }
    match /userPrices/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---- Online mağaza (/magaza) üyeleri: e-posta + şifre ile ayrı hesap; sadece kendi kaydını görür / değiştirir
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'createdAt', 'addresses', 'invoice', 'username', 'legal']));
      // değişiklik için e-posta doğrulanmış olmalı
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider in ['google.com', 'facebook.com'] || resource.data.get('byAdmin', false) == true) && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'addresses', 'invoice', 'email', 'photo', 'hiddenOrders', 'favs', 'notify', 'notifyHit'])
        && (!('notify' in request.resource.data) || (request.resource.data.notify is list && request.resource.data.notify.size() <= 200))
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 500))
        && (!('hiddenOrders' in request.resource.data) || (request.resource.data.hiddenOrders is list && request.resource.data.hiddenOrders.size() <= 500))
        && (!('photo' in request.resource.data) || request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 60000)));
      allow delete: if isAdmin();
    }
    // kullanıcı adı → e-posta (kullanıcı adıyla giriş için); sadece adı bilinerek okunur, listelenemez
    match /usernames/{name} {
      allow get: if true;
      allow create: if (isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid)) && request.resource.data.keys().hasOnly(['uid', 'email'])
        && name.matches('^[a-z0-9._-]{3,20}$');
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // ---- Online mağaza siparişleri: misafir ya da üye oluşturur (sadece "yeni" durumda); takip linki (tahmin edilemez kimlik) ile açılır
    match /orders/{id} {
      function own() { return signedIn() && resource.data.uid == request.auth.uid; }
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 30.10.2026: mağaza siparişi SADECE bekçiden (POST /order; fiyat ve toplam sunucuda katalogdan hesaplanır) yazılır.
      // Müşteri doğrudan yazamaz (eskiden tarayıcıdan fiyat değiştirilerek ucuza sipariş yazılabiliyordu).
      allow create: if isAdmin() && (request.resource.data.status == 'new' || (request.resource.data.status == 'confirmed' && request.resource.data.pay == 'card'))
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 300
        && request.resource.data.keys().hasOnly(['no', 'uid', 'member', 'status', 'createdAt', 'updatedAt', 'unread', 'history', 'items', 'total', 'rate', 'contact', 'delivery', 'invoice', 'pay', 'note', 'legal']);
      // üye kendi siparişini sadece "yeni" iken iptal edebilir
      allow update: if isAdmin() || (own() && resource.data.status == 'new' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'history']));
      allow delete: if isAdmin();
    }

    // ---- Mağaza özellikleri (29.10.2026, extras.jsx / reviews.jsx)
    // Popüler ürün verisi (tools/stats.mjs yazar) ve yorum özeti: herkes okur, yönetici yazar
    // Sipariş formu: kaydedilen formlar (sadece yönetici)
    match /oforms/{id} { allow read, write: if isAdmin(); }
    // Sepet linki (30.10.2026, lcart.jsx): yönetici hazırlar; linki bilen (kimlik tahmin edilemez) tek belgeyi okur, listeleyemez.
    // Müşteri sadece AÇIK sepeti bir kez onaylar: status open → sent + sub; ürünlere / fiyatlara dokunamaz.
    match /lcarts/{id} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (resource.data.status == 'open' && request.resource.data.status == 'sent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sub', 'subAt'])
        && request.resource.data.sub is map && request.resource.data.sub.keys().hasOnly(['items', 'contact', 'delivery', 'pay', 'note'])
        && request.resource.data.sub.items is list && request.resource.data.sub.items.size() <= resource.data.items.size()
        && request.resource.data.subAt == request.time);
    }
    match /stats/{d} { allow read: if true; allow write: if isAdmin(); }
    match /revsum/{d} { allow read: if true; allow write: if isAdmin(); }
    // Gelince haber ver: ürün başına bekleyen üyeler (eşitleme okur, bildirim gönderip siler). Üye sadece KENDİ kimliğini ekler / çıkarır.
    match /wait/{pid} {
      allow read: if isAdmin();
      allow create: if signedIn() && pid.matches('^[0-9]{1,9}$') && request.resource.data.keys().hasOnly(['uids', 'at']) && request.resource.data.uids == [request.auth.uid];
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['uids', 'at']) && request.resource.data.uids is list && request.resource.data.uids.size() <= 3000
        && request.resource.data.uids.toSet().difference(resource.data.uids.toSet()).union(resource.data.uids.toSet().difference(request.resource.data.uids.toSet())).hasOnly([request.auth.uid]);
      allow delete: if isAdmin();
    }
    // Ürün yorumu: kimlik = <sipariş>_<ürün>; sipariş üyenin olmalı ve teslime hazır / kargoda / tamamlanmış olmalı.
    // Ayarlarda "onaylayınca yayınlansın" açıksa sadece 'pending' ile oluşturulabilir.
    match /reviews/{id} {
      allow get, list: if isAdmin() || resource.data.status == 'pub' || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && id.matches('^[A-Za-z0-9_-]{6,60}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['pid', 'oid', 'order', 'uid', 'name', 'stars', 'text', 'status', 'createdAt', 'updatedAt', 'seenAdmin', 'sum'])
        && request.resource.data.pid is int && id == request.resource.data.oid + '_' + string(request.resource.data.pid)
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 800
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && get(/databases/$(database)/documents/orders/$(request.resource.data.oid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.oid)).data.status in ['ready', 'shipped', 'done']
        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'pub' && get(/databases/$(database)/documents/settings/public).data.get('feat', {}).get('rev', {}).get('moderate', true) == false));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- Sorun bildirimi (29.10.2026, issue.jsx): üye fotoğraf / video + açıklama gönderir (dosyalar bekçiyle R2 is/<id>/…),
    // yönetici durum + açıklama (+ fotoğraf) ile yanıtlar. Üye kendi kaydına sadece mesaj ekleyebilir / görüldü işaretler.
    match /issues/{id} {
      function ownIs() { return signedIn() && resource.data.uid == request.auth.uid; }
      allow get, list: if isAdmin() || ownIs();
      allow create: if signedIn() && id.matches('^[A-Za-z0-9]{10,40}$')
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['uid', 'no', 'name', 'email', 'phone', 'order', 'prod', 'text', 'files', 'status', 'createdAt', 'updatedAt', 'seenAdmin', 'seenUser', 'replies'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.files is list && request.resource.data.files.size() <= 5
        && (request.resource.data.files.size() <= 0 || request.resource.data.files[0].k.matches('^is/' + id + '/[cv][0-9][.](webp|jpg|mp4|mov|webm)$'))
        && (request.resource.data.files.size() <= 1 || request.resource.data.files[1].k.matches('^is/' + id + '/[cv][0-9][.](webp|jpg|mp4|mov|webm)$'))
        && (request.resource.data.files.size() <= 2 || request.resource.data.files[2].k.matches('^is/' + id + '/[cv][0-9][.](webp|jpg|mp4|mov|webm)$'))
        && (request.resource.data.files.size() <= 3 || request.resource.data.files[3].k.matches('^is/' + id + '/[cv][0-9][.](webp|jpg|mp4|mov|webm)$'))
        && (request.resource.data.files.size() <= 4 || request.resource.data.files[4].k.matches('^is/' + id + '/[cv][0-9][.](webp|jpg|mp4|mov|webm)$'));
      allow update: if isAdmin() || (ownIs() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'updatedAt', 'seenAdmin', 'seenUser'])
        && request.resource.data.replies is list && request.resource.data.replies.size() <= 80);
      allow delete: if isAdmin() || ownIs();
    }

    // ---- Ürün talebi (mağaza üyesi: fotoğraf + açıklama). Fotoğraflar bekçi üzerinden R2'ye (pr/<id>/…), kayıt burada.
    // Üye sadece kendi talebini görür / siler, yanıtı "görüldü" işaretler; yanıtı yönetici yazar.
    match /preq/{id} {
      function ownPq() { return signedIn() && resource.data.uid == request.auth.uid; }
      allow get, list: if isAdmin() || ownPq();
      allow create: if signedIn() && id.matches('^[A-Za-z0-9]{10,40}$')
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new'
        && request.resource.data.keys().hasOnly(['uid', 'no', 'name', 'email', 'phone', 'text', 'photos', 'status', 'createdAt', 'updatedAt', 'seenAdmin', 'seenUser'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 3
        && (request.resource.data.photos.size() <= 0 || request.resource.data.photos[0].matches('^pr/' + id + '/[0-9][.](webp|jpg)$')) && (request.resource.data.photos.size() <= 1 || request.resource.data.photos[1].matches('^pr/' + id + '/[0-9][.](webp|jpg)$')) && (request.resource.data.photos.size() <= 2 || request.resource.data.photos[2].matches('^pr/' + id + '/[0-9][.](webp|jpg)$'));
      allow update: if isAdmin() || (ownPq() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenUser']));
      allow delete: if isAdmin() || ownPq();
    }

    match /requests/{id} {
      function isGuestReq() { return resource.data.get('guest', false) == true; }
      function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
      // ziyaretçi talebi sadece kimliği (tahmin edilemez uzun numara) bilinerek açılabilir; listelenemez
      allow get: if isAdmin() || mine() || isGuestReq();
      allow list: if isAdmin() || mine();
      // vitrinden (/magaza) talep oluşturulamaz; sadece giriş yapmış aktif bayi
      allow create: if isActive() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        (mine() || (isGuestReq() && request.resource.data.guest == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastMsg', 'lastFrom', 'updatedAt', 'unreadAdmin', 'unreadUser'])
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'offered' && request.resource.data.status in ['accepted', 'rejected'])
          || (resource.data.status in ['new', 'offered'] && request.resource.data.status == 'cancelled')
        )
      );
      match /messages/{m} {
        function parent() { return get(/databases/$(database)/documents/requests/$(id)).data; }
        function parentAfter() { return getAfter(/databases/$(database)/documents/requests/$(id)).data; }
        allow read: if isAdmin() || (signedIn() && parent().uid == request.auth.uid) || parent().get('guest', false) == true;
        // getAfter: talep ve ilk mesajlar aynı anda (tek pakette) yazıldığı için talebin yazılmış halini kontrol eder
        allow delete: if isAdmin();
        allow create: if isAdmin() || (request.resource.data.from in ['user', 'system']
          && ((signedIn() && parentAfter().uid == request.auth.uid) || parentAfter().get('guest', false) == true));
      }
    }
  }
}
