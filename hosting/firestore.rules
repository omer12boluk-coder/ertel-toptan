rules_version = '2';
// ERTEL Toptan — Firestore güvenlik kuralları
// Bayi: sadece katalog + kendi talepleri + kendi özel fiyatları. Yönetici: her şey.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().role == 'admin'; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active != false; }

    // İlk kurulum: yönetici sahibi bir kez yazılır
    // otomatik eşitlemenin son çalışma bilgisi (sunucu yazar, yönetici okur)
    match /meta/sync { allow read: if isAdmin(); }
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // Giriş ekranındaki logo / dükkan bilgisi herkese açık
    match /settings/public { allow read: if true; allow write: if isAdmin(); }
    match /settings/{doc} { allow read: if isActive(); allow write: if isAdmin(); }
    match /catalog/{doc} { allow read: if isActive(); allow write: if isAdmin(); }
    // ziyaretçi mağazası: toptan fiyatsız katalog herkese açık
    match /pubcatalog/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /img/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /desc/{doc} { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // 1) bayi kendi başvurusunu yazar (pasif + onay bekliyor), 2) yönetici oluşturur, 3) ilk kurulumda sahip kendi kaydını yazar
      allow create: if (signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'customer'
          && request.resource.data.active == false
          && request.resource.data.pending == true
          && request.resource.data.keys().hasOnly(['uid', 'username', 'name', 'shop', 'phone', 'role', 'active', 'pending', 'tier', 'createdAt'])
          && request.resource.data.tier == '')
        || isAdmin()
        || (signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/meta/owner).data.uid == uid);
      // bayi sadece ad / dükkan / telefon / foto değiştirebilir
      allow update: if isAdmin() || (request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'shop', 'phone', 'photo']));
      allow delete: if isAdmin();
    }
    match /userNotes/{uid} { allow read, write: if isAdmin(); }
    match /userPrices/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /requests/{id} {
      function isGuestReq() { return resource.data.get('guest', false) == true; }
      function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
      // ziyaretçi talebi sadece kimliği (tahmin edilemez uzun numara) bilinerek açılabilir; listelenemez
      allow get: if isAdmin() || mine() || isGuestReq();
      allow list: if isAdmin() || mine();
      // vitrinden (/magaza) talep oluşturulamaz; sadece giriş yapmış aktif bayi
      allow create: if isActive() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        (mine() || (isGuestReq() && request.resource.data.guest == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastMsg', 'lastFrom', 'updatedAt', 'unreadAdmin', 'unreadUser'])
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'offered' && request.resource.data.status in ['accepted', 'rejected'])
          || (resource.data.status in ['new', 'offered'] && request.resource.data.status == 'cancelled')
        )
      );
      match /messages/{m} {
        function parent() { return get(/databases/$(database)/documents/requests/$(id)).data; }
        function parentAfter() { return getAfter(/databases/$(database)/documents/requests/$(id)).data; }
        allow read: if isAdmin() || (signedIn() && parent().uid == request.auth.uid) || parent().get('guest', false) == true;
        // getAfter: talep ve ilk mesajlar aynı anda (tek pakette) yazıldığı için talebin yazılmış halini kontrol eder
        allow delete: if isAdmin();
        allow create: if isAdmin() || (request.resource.data.from in ['user', 'system']
          && ((signedIn() && parentAfter().uid == request.auth.uid) || parentAfter().get('guest', false) == true));
      }
    }
  }
}
